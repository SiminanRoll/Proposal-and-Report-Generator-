{
  "name": "client-compass",
  "version": "1.0.9.14",
  "private": true,
  "description": "Browser-local current-state client opportunity, technology review, and proposal workspace for Advantage Technologies.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prepare:pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "dev": "npm run prepare:pdf-worker && next dev",
    "build": "npm run clean && npm run prepare:pdf-worker && next build",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check": "npm run verify"
  },
  "dependencies": {
    "mammoth": "1.9.1",
    "next": "16.2.11",
    "pdfjs-dist": "4.8.69",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "typescript": "5.9.3"
  }
}

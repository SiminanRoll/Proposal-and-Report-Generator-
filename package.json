{
  "name": "proposal-and-report-generator",
  "version": "1.0.3.15",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean:legacy-sharing": "node scripts/clean-legacy-sharing.mjs",
    "prepare:pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "postinstall": "npm run clean:legacy-sharing && npm run prepare:pdf-worker",
    "dev": "npm run clean:legacy-sharing && npm run prepare:pdf-worker && next dev",
    "build": "npm run clean:legacy-sharing && npm run prepare:pdf-worker && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "mammoth": "^1.9.1",
    "next": "16.2.11",
    "pdfjs-dist": "4.8.69",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.11",
    "typescript": "^5.9.0"
  }
}
